DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tracker.example.com
DJANGO_CORS_ORIGINS=https://tracker.example.com
# Generate with: vapid --gen && vapid --applicationServerKey (see DEPLOY.md)
VAPID_PRIVATE_KEY=generate-with-vapid-gen
VAPID_CLAIMS_EMAIL=you@example.com
# Google Calendar sync — Web application OAuth client from
# https://console.cloud.google.com/apis/credentials (see DEPLOY.md)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://tracker.example.com/api/google/oauth/callback/
FRONTEND_URL=https://tracker.example.com